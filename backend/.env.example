# Copie este archivo como .env para desarrollo local. En Railway, defina las
# mismas variables en la pestaña Variables del servicio.
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=cambie-esta-clave-en-produccion
DATABASE_URL=sqlite:///./energia_iot.db

MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=medidor
MQTT_PASSWORD=cambie-esta-clave
MQTT_USE_TLS=false
MQTT_TOPIC_BASE=medidor/#

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambie-esta-clave
CORS_ORIGINS=http://localhost:5173

OFFLINE_UMBRAL_MIN=15
VOLTAJE_NOMINAL=120
VOLTAJE_TOLERANCIA_PCT=10
VOLTAJE_PERSISTENCIA_S=60
